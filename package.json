{
  "name": "glyph",
  "version": "1.0.0",
  "private": true,
  "description": "One letter morphs through 570 years of type: a code-rendered film where every number is measured from the outlines on screen.",
  "type": "module",
  "license": "MIT",
  "author": "Victor Isaac",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --format=esm --target=es2022 --outfile=dist/glyph.js",
    "score": "esbuild score/score.ts --bundle --platform=node --format=esm --outfile=score/score.mjs --log-level=warning && reel score score/score.mjs -o score/score.wav",
    "sheet": "reel sheet index.html -o media/sheet.png --size 1920x1080 --every 2",
    "render": "reel render index.html -o media/glyph-16x9.mp4 --size 1920x1080 --subframes 4 --workers 2 --audio score/score.wav",
    "render:square": "reel render index.html -o media/glyph-1x1.mp4 --size 1080x1080 --subframes 4 --workers 2 --audio score/score.wav",
    "test": "esbuild test/*.test.ts --bundle --platform=node --format=esm --outdir=dist/test --log-level=warning && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "opentype.js": "^1.3.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/opentype": {
      "js": "^1.3.8"
    },
    "esbuild": "^0.28.0",
    "reel-film": "file:../reel",
    "sharp": "^0.34.0",
    "typescript": "^5.6.0"
  }
}
